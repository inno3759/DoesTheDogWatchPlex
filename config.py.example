# DoesTheDogWatchPlex Configuration
# Copy this file to config.py and fill in your details.

# --- Plex Settings ---
# Your Plex server URL (include port if non-standard)
PLEX_URL = "http://localhost:32400"

# Your Plex authentication token
# Find it: open Plex web, inspect any request, look for X-Plex-Token parameter
# Or see: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN = "your-plex-token-here"

# Library names to process (case-sensitive, as they appear in Plex)
# Set to None to process ALL movie libraries
PLEX_LIBRARIES = ["Movies"]

# --- DoesTheDogDie Settings ---
# Get your API key: sign up at doesthedogdie.com, then visit /profile
DTDD_API_KEY = "your-dtdd-api-key-here"

# --- Behavior ---
# Separator line between original summary and content warnings
SEPARATOR = "\n\n———— Content Warnings (via DoesTheDogDie.com) ————"

# Minimum yes votes for a warning to be included (filters out low-confidence entries)
MIN_YES_VOTES = 5

# Only show warnings where "yes" votes outnumber "no" votes by this ratio
MIN_YES_RATIO = 0.7

# Show the ✅ "safe" topics (e.g., "no dogs die")? These lists tend to be huge.
# Set to True if you want them included.
SHOW_SAFE_TOPICS = False

# --- Topic Filtering ---
# Only show warnings for these specific topics (by name from DTDD).
# If set, ONLY these topics will appear. Leave as None to show all.
# Run: python plex_warnings.py --list-topics to see all available topic names.
# Example:
# INCLUDE_TOPICS = [
#     "a dog dies",
#     "a cat dies",
#     "someone is sexually assaulted",
#     "someone dies by suicide",
#     "there's flashing lights or images",
#     "someone self harms",
#     "there's excessive gore",
# ]
INCLUDE_TOPICS = None

# Exclude these specific topics (ignored if INCLUDE_TOPICS is set).
# Example:
# EXCLUDE_TOPICS = ["there is copaganda", "there are shower scenes"]
EXCLUDE_TOPICS = None

# --- Translation ---
# Translate topic names to another language before writing to Plex.
# Uses Google Translate. Set to a language code (e.g., "es", "fr", "de", "pt", "ja").
# Leave as None for English (default). Translations are cached locally.
# Full list of supported codes: https://cloud.google.com/translate/docs/languages
LANGUAGE = None

# How long to cache DTDD results locally (seconds). Default: 7 days
CACHE_TTL = 60 * 60 * 24 * 7

# Rate limit delay between DTDD API calls (seconds) — be kind to their server
API_DELAY = 1.0

# Dry run mode: if True, prints what would change without modifying Plex
DRY_RUN = False

# --- Marker Pipeline (optional — leave ENABLE_MARKERS = False to use original behaviour) ---
# When disabled, the script works exactly as the original: it only edits Plex descriptions.
# When enabled, it also calls Gemini to extract timestamps from DTDD comments and creates
# timed markers in Plex so triggering scenes can be skipped during playback.
#
# Requirements to enable:
#   1. pip install google-genai
#   2. Set GEMINI_API_KEY below
#   3. Set ENABLE_MARKERS = True
#
# If any required value is missing or invalid, markers are silently disabled and a
# one-time warning is printed — the description-editing feature is unaffected.

# Gemini API key. Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "your-gemini-api-key-here"

# Gemini model to use for timestamp extraction.
GEMINI_MODEL = "gemini-3.1-pro-preview"

# Master toggle. Set to True to enable Gemini timestamp extraction + Plex marker creation.
# False (default) = original behaviour only (description editing, no Gemini, no markers).
ENABLE_MARKERS = False

# Type of Plex marker to create for triggering scenes.
# One of: intro, commercial, bookmark, resume, credits
#
# IMPORTANT: Only "bookmark" can be created via the Plex HTTP API by external
# tools. The other types (intro, commercial, credits, resume) are reserved for
# Plex's internal AI analysis engine — the server rejects external POST requests
# for those types with HTTP 400.
#
# If you need "commercial" skip-button behaviour, you will need direct SQLite
# access to the Plex database (not supported in the HTTP API mode).
MARKER_TYPE = "bookmark"

# Minimum scene duration in seconds required to create a marker.
# Scenes shorter than this are ignored. 0 = accept any duration (no minimum).
# Example: 10 = skip scenes under 10 seconds.
MIN_MARKER_DURATION_S = 0

# How long to cache the all-episodes (-1,-1) discovery call for TV shows (seconds).
# Shorter than CACHE_TTL so new episodes on ongoing shows are picked up sooner.
# Default: 86400 = 1 day (matches typical SCHEDULE interval).
DISCOVERY_CACHE_TTL = 86400
